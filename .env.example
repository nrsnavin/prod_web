# Base URL of the backend API (include /api/v2).
# In dev you can leave this unset — Vite proxies /api to VITE_PROXY_TARGET.
# Production builds default to https://api.baluelastics.com/api/v2 (see
# src/app/config.ts); set this only to point at a different backend.
VITE_API_BASE_URL=/api/v2

# Dev-only: where the Vite proxy forwards /api requests.
VITE_PROXY_TARGET=https://api.baluelastics.com
